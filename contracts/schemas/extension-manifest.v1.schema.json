{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmos.local/schemas/extension-manifest.v1.schema.json",
  "title": "Cosmos Extension Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "version", "category", "runtime_api_version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "display_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "category": {
      "enum": [
        "user-tool",
        "system-tool",
        "entity",
        "capability-bundle",
        "theme",
        "workspace-blueprint",
        "object-blueprint",
        "capture-template",
        "provider",
        "integration"
      ]
    },
    "runtime_api_version": { "type": "string", "minLength": 1 },
    "runtime_kind": {
      "type": "string",
      "enum": ["native", "web", "service", "desktop", "command"]
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "entry_points": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "default": {}
    }
  }
}
