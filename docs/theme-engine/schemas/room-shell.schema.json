{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cosmos:schema:theme-engine:room-shell:1",
  "title": "Cosmos Room Shell",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "shellId",
    "version",
    "displayName",
    "compatibility",
    "referenceViewport",
    "camera",
    "perspectiveProfile",
    "architectureSurfaces",
    "placementSurfaces",
    "placementAreas",
    "attachmentAnchors",
    "lightAnchors",
    "safeAreas",
    "layerBands",
    "coreFallbackShellRef"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 1 },
    "shellId": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" },
    "version": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/semver" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "compatibility": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/compatibility" },
    "referenceViewport": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/referenceViewport" },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "angleDegrees", "horizon", "depthPolicy", "scaleReference"],
      "properties": {
        "projection": { "enum": ["orthographic", "perspective", "illustrated-fixed"] },
        "angleDegrees": { "type": "number", "minimum": -180, "maximum": 180 },
        "horizon": { "type": "number" },
        "depthPolicy": { "enum": ["layer-depth", "surface-depth"] },
        "scaleReference": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "perspectiveProfile": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/symbol" },
    "architectureSurfaces": {
      "type": "array",
      "minItems": 3,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surfaceId", "surfaceKind", "geometry", "normal", "layerBandId", "depth", "pointerPolicy"],
        "properties": {
          "surfaceId": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" },
          "surfaceKind": { "enum": ["floor", "wall", "ceiling", "background-opening", "architecture"] },
          "geometry": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/shape" },
          "normal": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/vector3" },
          "layerBandId": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/symbol" },
          "depth": { "type": "number", "minimum": -1000, "maximum": 1000 },
          "pointerPolicy": { "const": "passive" }
        }
      }
    },
    "placementSurfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surfaceId",
          "surfaceKind",
          "bounds",
          "normal",
          "basisX",
          "basisY",
          "placementAreaIds",
          "anchorIds",
          "layerBandId",
          "depth",
          "snapPriority"
        ],
        "properties": {
          "surfaceId": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" },
          "surfaceKind": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/surfaceKind" },
          "bounds": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/shape" },
          "normal": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/vector3" },
          "basisX": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/vector3" },
          "basisY": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/vector3" },
          "placementAreaIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" }
          },
          "anchorIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" }
          },
          "layerBandId": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/symbol" },
          "depth": { "type": "number", "minimum": -1000, "maximum": 1000 },
          "snapPriority": { "type": "integer", "minimum": -1000, "maximum": 1000 }
        }
      }
    },
    "placementAreas": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["areaId", "surfaceId", "bounds", "safe"],
        "properties": {
          "areaId": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" },
          "surfaceId": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" },
          "bounds": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/shape" },
          "safe": { "type": "boolean" }
        }
      }
    },
    "attachmentAnchors": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/attachmentAnchor" }
    },
    "lightAnchors": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchorId", "position", "normal", "lightRole"],
        "properties": {
          "anchorId": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" },
          "position": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/point" },
          "normal": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/vector3" },
          "lightRole": { "enum": ["ambient", "key", "fill", "accent"] }
        }
      }
    },
    "safeAreas": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/safeArea" }
    },
    "layerBands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/layerBand" }
    },
    "coreFallbackShellRef": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/versionedRef" }
  },
  "$defs": {
    "attachmentAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchorId", "role", "position", "normal", "compatibleFamilies", "acceptedAttachmentRoles", "priority"],
      "properties": {
        "anchorId": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" },
        "role": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/symbol" },
        "position": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/point" },
        "normal": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/vector3" },
        "compatibleFamilies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/catalogFamily" }
        },
        "acceptedAttachmentRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/symbol" }
        },
        "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 }
      }
    }
  }
}
