{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cosmos:schema:theme-engine:catalog-object:1",
  "title": "Cosmos Catalog Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogObjectId",
    "version",
    "displayName",
    "family",
    "compatibility",
    "visualSlots",
    "defaultBounds",
    "pivot",
    "placementProfile",
    "attachmentAnchors",
    "collisionProfile",
    "states",
    "skinCompatibility",
    "perspectiveProfile",
    "scale",
    "layerCompatibility"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 1 },
    "catalogObjectId": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" },
    "version": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/semver" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "family": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/catalogFamily" },
    "compatibility": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/compatibility" },
    "visualSlots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/assetSlot" }
    },
    "defaultBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "layout", "effect"],
      "properties": {
        "visual": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/shape" },
        "layout": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/shape" },
        "effect": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/shape" },
        "label": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/shape" }
      }
    },
    "pivot": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/point" },
    "placementProfile": { "$ref": "urn:cosmos:schema:theme-engine:placement-profile:1" },
    "attachmentAnchors": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchorId", "role", "position", "normal", "compatibleFamilies", "acceptedAttachmentRoles", "priority"],
        "properties": {
          "anchorId": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" },
          "role": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/symbol" },
          "position": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/point" },
          "normal": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/vector3" },
          "compatibleFamilies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/catalogFamily" }
          },
          "acceptedAttachmentRoles": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/symbol" }
          },
          "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 }
        }
      }
    },
    "collisionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "boundsRole", "blocksPlacement"],
      "properties": {
        "mode": { "enum": ["solid", "soft", "overlap-allowed"] },
        "boundsRole": { "const": "layout" },
        "blocksPlacement": { "type": "boolean" }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/templateState" }
    },
    "skinCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentationGroup", "requiredSlotIds", "coreFallbackSkinRef"],
      "properties": {
        "presentationGroup": { "const": "room" },
        "requiredSlotIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/namespacedId" }
        },
        "coreFallbackSkinRef": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/versionedRef" }
      }
    },
    "perspectiveProfile": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/symbol" },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultX", "defaultY", "minimum", "maximum"],
      "properties": {
        "defaultX": { "type": "number", "exclusiveMinimum": 0 },
        "defaultY": { "type": "number", "exclusiveMinimum": 0 },
        "minimum": { "type": "number", "exclusiveMinimum": 0 },
        "maximum": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "layerCompatibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:cosmos:schema:theme-engine:room-common:1#/$defs/symbol" }
    },
    "functionContainerCompatibility": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "knowledge-workspace",
          "creation-workspace",
          "room-transition",
          "companion-interaction",
          "tool-entry",
          "base-exit"
        ]
      }
    }
  }
}
