{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cosmos:schema:theme-engine:theme-manifest:1",
  "title": "Cosmos Theme Manifest",
  "description": "Manifest for a complete Cosmos Theme or a presentation Group Pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "themeId",
    "version",
    "displayName",
    "packageKind",
    "compatibility",
    "groups",
    "packRefs",
    "tokens",
    "systemTerms"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "themeId": {
      "$ref": "#/$defs/namespacedId"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "packageKind": {
      "enum": [
        "full-theme",
        "group-pack"
      ]
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/presentationGroup"
      }
    },
    "packRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/versionedRef"
      }
    },
    "defaultCompositionRef": {
      "$ref": "#/$defs/versionedRef"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "default": []
    },
    "tokens": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/namespacedId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/typedToken"
      }
    },
    "systemTerms": {
      "$ref": "#/$defs/systemTerms"
    },
    "author": {
      "$ref": "#/$defs/author"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "packageKind": {
            "const": "full-theme"
          }
        },
        "required": [
          "packageKind"
        ]
      },
      "then": {
        "properties": {
          "groups": {
            "allOf": [
              { "contains": { "const": "world" } },
              { "contains": { "const": "map" } },
              { "contains": { "const": "base-entry" } },
              { "contains": { "const": "base-interior" } },
              { "contains": { "const": "room" } },
              { "contains": { "const": "workspace" } },
              { "contains": { "const": "window" } },
              { "contains": { "const": "companion" } },
              { "contains": { "const": "icon" } },
              { "contains": { "const": "node" } },
              { "contains": { "const": "connection" } },
              { "contains": { "const": "label" } },
              { "contains": { "const": "status" } }
            ]
          }
        },
        "required": [
          "defaultCompositionRef"
        ]
      }
    }
  ],
  "$defs": {
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
      "minLength": 3,
      "maxLength": 200
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "versionRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "versionRange"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/namespacedId"
        },
        "versionRange": {
          "$ref": "#/$defs/versionRange"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "versionRange",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/namespacedId"
        },
        "versionRange": {
          "$ref": "#/$defs/versionRange"
        },
        "kind": {
          "enum": [
            "theme",
            "skin-pack",
            "template-pack",
            "renderer-pack"
          ]
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "themeEngine"
      ],
      "properties": {
        "themeEngine": {
          "$ref": "#/$defs/versionRange"
        },
        "cosmos": {
          "$ref": "#/$defs/versionRange"
        }
      }
    },
    "presentationGroup": {
      "enum": [
        "world",
        "map",
        "base-entry",
        "base-interior",
        "room",
        "workspace",
        "window",
        "companion",
        "icon",
        "node",
        "connection",
        "label",
        "status",
        "ambient"
      ]
    },
    "typedToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "color",
            "length",
            "number",
            "duration",
            "shadow",
            "font-family",
            "opacity",
            "string",
            "boolean"
          ]
        },
        "value": {
          "oneOf": [
            { "type": "string", "maxLength": 1000 },
            { "type": "number" },
            { "type": "boolean" }
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "number",
                  "opacity"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    },
    "systemTerms": {
      "type": "object",
      "propertyNames": {
        "pattern": "^system\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "keywords": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    }
  }
}
